TELEGRAM_BOT_TOKEN=your_bot_token_here
# Telegram user id of the bot owner (optional). Required for access approval workflow.
BOT_OWNER_ID=
# Owner dashboard pagination and alert rate limits
OWNER_USERS_PER_PAGE=10
OWNER_ALERT_COOLDOWN_SEC=60
BITTENSOR_NETWORK=finney
DATA_DIR=./data
SLIPPAGE_TOLERANCE=0.005
MONITOR_TICK_SEC=5
PRICE_CACHE_TTL_SEC=5
PRICE_NOTIFY_INTERVAL_SEC=60
TELEGRAM_CHAT_MIN_INTERVAL_SEC=1.2
ORDER_LIST_LIMIT=15
LOG_LEVEL=INFO
# Fernet encryption key for persisting wallet passwords across bot restarts (recommended).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WALLET_SECRET_KEY=
